<PaystubItemScreen>:

    name: "pay_item"

    FloatLayout:

        ScrollView:
            do_scroll_x: False
            do_scroll_y: True

            MDBoxLayout:
                orientation: "vertical"
                spacing: dp(14)

                padding: dp(22), dp(22), dp(22), dp(40)

                size_hint_y: None
                height: self.minimum_height

                # -------------------------------------------------
                # HEADER
                # -------------------------------------------------

                MDBoxLayout:
                    size_hint_y: None
                    height: dp(68)

                    MDCard:
                        size_hint: None, None
                        size: dp(56), dp(56)

                        radius: [16]

                        elevation: 0

                        theme_bg_color: "Custom"
                        md_bg_color: (.88, .87, .94, 1)

                        MDIcon:
                            icon: "chevron-left"
                            font_size: dp(34)
                            theme_text_color: "Custom"
                            text_color: (.25, .25, .32, 1)
                            halign: "center"
                            valign: "center"
                            text_size: self.size

                        #on_release:
                            #root.go_back()

                    MDBoxLayout:
                        orientation: "vertical"

                        padding: dp(14), dp(0), dp(0), dp(0)

                        MDLabel:
                            text: "Shift"
                            font_size: dp(22)
                            bold: True
                            adaptive_height: True

                        MDLabel:
                            text: root.show_name
                            font_size: dp(15)
                            theme_text_color: "Secondary"
                            adaptive_height: True
                            shorten: True
                            shorten_from: "right"


                # -------------------------------------------------
                # SHIFT
                # -------------------------------------------------

                MDLabel:
                    text: "SHIFT"
                    font_size: dp(15)
                    bold: True
                    theme_text_color: "Secondary"

                    size_hint_y: None
                    height: dp(24)


                MDCard:
                    size_hint_y: None
                    height: dp(150)

                    padding: dp(18)

                    radius: [20]

                    elevation: 1

                    theme_bg_color: "Custom"
                    md_bg_color: (.88, .87, .94, 1)

                    MDBoxLayout:
                        orientation: "vertical"
                        spacing: dp(3)

                        MDLabel:
                            text: root.position
                            font_size: dp(24)
                            bold: True

                            adaptive_height: True

                        MDLabel:
                            text: root.show_name
                            font_size: dp(18)
                            bold: True

                            adaptive_height: True
                            shorten: True
                            shorten_from: "right"

                        MDLabel:
                            text: root.shift_date
                            font_size: dp(15)
                            theme_text_color: "Secondary"

                            adaptive_height: True

                        MDLabel:
                            text: root.shift_time
                            font_size: dp(17)
                            bold: True

                            adaptive_height: True


                # -------------------------------------------------
                # PAYROLL
                # -------------------------------------------------

                MDLabel:
                    text: "PAYROLL"
                    font_size: dp(15)
                    bold: True
                    theme_text_color: "Secondary"

                    size_hint_y: None
                    height: dp(24)


                MDCard:
                    size_hint_y: None
                    height: dp(230)

                    padding: dp(18)

                    radius: [20]

                    elevation: 1

                    theme_bg_color: "Custom"
                    md_bg_color: (.96, .95, .97, 1)

                    MDBoxLayout:
                        orientation: "vertical"
                        spacing: dp(2)

                        MDBoxLayout:
                            size_hint_y: None
                            height: dp(30)

                            MDLabel:
                                text: "Regular"

                            MDLabel:
                                text: root.reg_hours
                                halign: "right"
                                text_size: self.size

                        MDBoxLayout:
                            size_hint_y: None
                            height: dp(30)

                            MDLabel:
                                text: "Overtime"

                            MDLabel:
                                text: root.ot_hours
                                halign: "right"
                                text_size: self.size

                        MDBoxLayout:
                            size_hint_y: None
                            height: dp(30)

                            MDLabel:
                                text: "Double Time"

                            MDLabel:
                                text: root.dt_hours
                                halign: "right"
                                text_size: self.size

                        MDBoxLayout:
                            size_hint_y: None
                            height: dp(30)

                            MDLabel:
                                text: "Weekly OT"

                            MDLabel:
                                text: root.weekly_ot_hours
                                halign: "right"
                                text_size: self.size

                        MDBoxLayout:
                            size_hint_y: None
                            height: dp(30)

                            MDLabel:
                                text: "Meal Penalty"

                            MDLabel:
                                text: root.meal_penalty_hours
                                halign: "right"
                                text_size: self.size

                        MDBoxLayout:
                            size_hint_y: None
                            height: dp(30)

                            MDLabel:
                                text: "Rest Break"

                            MDLabel:
                                text: root.rest_break_penalty_hours
                                halign: "right"
                                text_size: self.size


                # -------------------------------------------------
                # EARNINGS MATH
                # -------------------------------------------------

                MDLabel:
                    text: "EARNINGS"
                    font_size: dp(15)
                    bold: True
                    theme_text_color: "Secondary"

                    size_hint_y: None
                    height: dp(24)


                MDCard:
                    size_hint_y: None
                    height: dp(190)

                    padding: dp(18)

                    radius: [20]

                    elevation: 1

                    theme_bg_color: "Custom"
                    md_bg_color: (.96, .95, .97, 1)

                    MDBoxLayout:
                        orientation: "vertical"
                        spacing: dp(5)

                        MDLabel:
                            text: root.reg_hours + " × " + root.base_rate
                            font_size: dp(15)

                            adaptive_height: True

                        MDLabel:
                            text: root.ot_hours + " × 1.5 × " + root.base_rate
                            font_size: dp(15)

                            adaptive_height: True

                        MDLabel:
                            text: "Weekly OT: " + root.weekly_ot_hours
                            font_size: dp(14)

                            theme_text_color: "Secondary"

                            adaptive_height: True

                        Widget:
                            size_hint_y: None
                            height: dp(6)

                        MDBoxLayout:
                            size_hint_y: None
                            height: dp(1)

                            md_bg_color: (.75, .74, .80, 1)

                        Widget:
                            size_hint_y: None
                            height: dp(6)

                        MDBoxLayout:
                            size_hint_y: None
                            height: dp(34)

                            MDLabel:
                                text: "Payroll"
                                font_size: dp(17)
                                bold: True

                            MDLabel:
                                text: root.total_pay
                                font_size: dp(19)
                                bold: True

                                halign: "right"
                                valign: "center"
                                text_size: self.size


                # -------------------------------------------------
                # RATES
                # -------------------------------------------------

                MDLabel:
                    text: "RATES"
                    font_size: dp(15)
                    bold: True
                    theme_text_color: "Secondary"

                    size_hint_y: None
                    height: dp(24)


                MDCard:
                    size_hint_y: None
                    height: dp(82)

                    padding: dp(18)

                    radius: [20]

                    elevation: 1

                    theme_bg_color: "Custom"
                    md_bg_color: (.88, .87, .94, 1)

                    MDBoxLayout:
                        orientation: "vertical"

                        MDBoxLayout:
                            size_hint_y: None
                            height: dp(30)

                            MDLabel:
                                text: "Base Rate"

                            MDLabel:
                                text: root.base_rate
                                halign: "right"
                                text_size: self.size

                        MDBoxLayout:
                            size_hint_y: None
                            height: dp(30)

                            MDLabel:
                                text: "Blended Rate"

                            MDLabel:
                                text: root.blended_rate
                                halign: "right"
                                text_size: self.size


                # -------------------------------------------------
                # JOB INFO
                # -------------------------------------------------

                MDLabel:
                    text: "JOB"
                    font_size: dp(15)
                    bold: True
                    theme_text_color: "Secondary"

                    size_hint_y: None
                    height: dp(24)


                MDCard:
                    size_hint_y: None
                    height: dp(112)

                    padding: dp(18)

                    radius: [20]

                    elevation: 1

                    theme_bg_color: "Custom"
                    md_bg_color: (.96, .95, .97, 1)

                    MDBoxLayout:
                        orientation: "vertical"
                        spacing: dp(3)

                        MDLabel:
                            text: "Job " + root.job_number
                            font_size: dp(16)
                            bold: True

                            adaptive_height: True

                        MDLabel:
                            text: root.client
                            font_size: dp(15)
                            theme_text_color: "Secondary"

                            adaptive_height: True
                            shorten: True
                            shorten_from: "right"

                        MDLabel:
                            text: root.position
                            font_size: dp(15)
                            theme_text_color: "Secondary"

                            adaptive_height: True
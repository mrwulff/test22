<PayScreen>:
    name: "pay"

    FloatLayout:

        # --------------------------------------------------
        # Main content
        # --------------------------------------------------

        MDBoxLayout:
            orientation: "vertical"
            padding: dp(20), dp(18), dp(20), dp(90)
            spacing: dp(8)

            MDBoxLayout:
                size_hint_y: None
                height: dp(58)

                MDBoxLayout:
                    orientation: "vertical"

                    MDLabel:
                        text: "Pay"
                        font_size: dp(32)
                        bold: True
                        adaptive_height: True

                    MDLabel:
                        text: "Your payroll history"
                        theme_text_color: "Secondary"
                        font_size: dp(16)
                        adaptive_height: True

            # --------------------------------------------------
            # Paystub list
            # --------------------------------------------------

            RecycleView:
                id: paystub_list
                viewclass: "PaystubCard"

                RecycleBoxLayout:
                    default_size: None, dp(108)
                    default_size_hint: 1, None
                    size_hint_y: None
                    height: self.minimum_height
                    orientation: "vertical"
                    spacing: dp(10)

        # --------------------------------------------------
        # Import FAB
        # --------------------------------------------------

        MDFabButton:
            icon: "sort"
            style: "small"
            pos_hint: {"right": .94, "y": .21}
            on_release:
                root.show_sort_menu(self)

        MDFabButton:
            icon: "plus"
            style: "small"
            pos_hint: {"right": .94, "y": .12}
            on_release:
                root.import_paystub()

    NavigationBar:
        selected: "pay"

# ==========================================================
# Individual paystub card
# ==========================================================

<PaystubCard@MDCard>:

    orientation: "horizontal"

    size_hint_y: None
    height: dp(108)

    padding: dp(16)

    radius: [22]

    elevation: 1

    ripple_behavior: True

    theme_bg_color: "Custom"
    md_bg_color: (.91, .90, .95, 1)

    on_release:
        app.open_paystub(root.paystub_id)

    MDBoxLayout:

        orientation: "horizontal"
        spacing: dp(12)

        # --------------------------------------------------
        # Calendar icon
        # --------------------------------------------------

        MDCard:
            size_hint: None, None
            size: dp(52), dp(52)

            pos_hint: {"center_x": .5, "center_y": .5}
            #size_hint: 1, None
            #radius: [22]

            radius: [26]

            theme_bg_color: "Custom"
            md_bg_color: (.84, .83, .91, 1)

            MDIcon:
                icon: "calendar-month"
                theme_text_color: "Custom"
                text_color: (.30, .30, .38, 1)

        # --------------------------------------------------
        # Paystub information
        # --------------------------------------------------

        MDBoxLayout:

            orientation: "vertical"

            spacing: dp(2)

            MDLabel:
                text: root.pay_date
                font_size: dp(19)
                bold: True
                adaptive_height: True

            MDLabel:
                text: root.period
                font_size: dp(15)
                theme_text_color: "Secondary"
                adaptive_height: True

            MDLabel:
                text: root.summary
                font_size: dp(13)
                theme_text_color: "Secondary"
                adaptive_height: True

        # --------------------------------------------------
        # Amount
        # --------------------------------------------------

        MDBoxLayout:

            orientation: "horizontal"

            size_hint_x: None
            width: dp(145)

            spacing: dp(4)

            MDLabel:
                text: root.total
                font_size: dp(21)
                bold: True
                halign: "right"
                valign: "center"
                text_size: self.size

            MDIcon:
                icon: "chevron-right"
                theme_text_color: "Custom"
                text_color: (.35, .35, .40, 1)
                size_hint_x: None
                width: dp(24)


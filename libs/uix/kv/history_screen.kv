#:import dp kivy.metrics.dp


# ============================================================
# SCHEDULE MARKER
# ============================================================

<ScheduleMarkerItem>:
    orientation: "vertical"
    size_hint_y: None
    height: dp(60)

    MDCard:
        size_hint_y: None
        height: dp(60)

        style: "filled"
        radius: [12, 12, 12, 12]

        padding: dp(16), dp(8)

        MDBoxLayout:
            orientation: "vertical"
            spacing: dp(1)

            MDLabel:
                text: root.marker_title
                font_size: "12sp"
                bold: True
                theme_text_color: "Secondary"

            MDLabel:
                text: root.marker_subtitle
                font_size: "15sp"


# ============================================================
# TODAY MARKER
# ============================================================

<ScheduleTodayItem>:
    orientation: "vertical"
    size_hint_y: None
    height: dp(44)

    MDCard:
        size_hint_y: None
        height: dp(44)

        style: "filled"
        radius: [12, 12, 12, 12]

        padding: dp(16), 0

        MDLabel:
            text: "TODAY"
            bold: True
            font_size: "13sp"
            theme_text_color: "Secondary"
            valign: "center"


# ============================================================
# HISTORY / SCHEDULE SCREEN
# ============================================================

<HistoryScreen>:

    name: "history"

    MDBoxLayout:

        orientation: "vertical"

        RecycleView:

            id: schedule_rv

            do_scroll_x: False
            bar_width: dp(4)

            # Default view class for normal schedule entries.
            # key_viewclass overrides this for:
            #   ScheduleMarkerItem
            #   ScheduleTodayItem
            viewclass: "ShowCard"
            key_viewclass: "key_viewclass"

            RecycleBoxLayout:

                # The Python data supplies the exact height
                # through the "_rv_size" key.
                key_size: "_rv_size"

                default_size: None, None
                default_size_hint: 1, None

                size_hint_y: None
                height: self.minimum_height

                orientation: "vertical"

                spacing: dp(8)

                padding:
                    dp(12), dp(8), dp(12), dp(24)

    NavigationBar:
        selected: "calendar"
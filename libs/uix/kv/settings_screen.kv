<SettingsScreen>:
    name: "settings"

    BoxLayout:
        orientation: "vertical"



        ScrollView:
            do_scroll_x: False

            MDBoxLayout:
                orientation: "vertical"
                adaptive_height: True
                spacing: dp(18)
                padding: dp(16), dp(12), dp(16), dp(24)

                # -------------------------------------------------
                # ACCOUNT
                # -------------------------------------------------

                MDLabel:
                    text: "ACCOUNT"
                    font_size: "13sp"
                    bold: True
                    theme_text_color: "Secondary"
                    size_hint_y: None
                    height: dp(28)
                    padding_x: dp(4)

                MDCard:
                    style: "outlined"
                    radius: [16, 16, 16, 16]
                    adaptive_height: True

                    MDList:
                        spacing: 0

                        MDListItem:
                            on_release: app.new_login()

                            MDListItemLeadingIcon:
                                icon: "key"

                            MDListItemHeadlineText:
                                text: "Rhino Login"

                        MDListItem:
                            on_release: app.paystub()

                            MDListItemLeadingIcon:
                                icon: "money-check"

                            MDListItemHeadlineText:
                                text: "Paystub"

                # -------------------------------------------------
                # DATA
                # -------------------------------------------------

                MDLabel:
                    text: "DATA"
                    font_size: "13sp"
                    bold: True
                    theme_text_color: "Secondary"
                    size_hint_y: None
                    height: dp(28)
                    padding_x: dp(4)

                MDCard:
                    style: "outlined"
                    radius: [16, 16, 16, 16]
                    adaptive_height: True

                    MDList:
                        spacing: 0

                        MDListItem:
                            on_release: app.dlpp()

                            MDListItemLeadingIcon:
                                icon: "cloud-download"

                            MDListItemHeadlineText:
                                text: "Download New Paystubs"

                        MDListItem:
                            #on_release: app.delete_changes_db()

                            MDListItemLeadingIcon:
                                icon: "delete-circle"

                            MDListItemHeadlineText:
                                text: "Reset Changes"

                        MDListItem:
                            #on_release: app.menu_items()

                            MDListItemLeadingIcon:
                                icon: "menu-open"

                            MDListItemHeadlineText:
                                text: "Edit Menu"

                        MDListItem:

                            MDListItemLeadingIcon:
                                icon: "cancel"

                            MDListItemHeadlineText:
                                text: "Clear All Data"

                        MDListItem:
                            #on_release: app.remove_google_token("token2.json")

                            MDListItemLeadingIcon:
                                icon: "delete"

                            MDListItemHeadlineText:
                                text: "Delete Google Data"
                ###backup
                                # -------------------------------------------------
                # BACKUP & RESTORE
                # -------------------------------------------------

                MDLabel:
                    text: "BACKUP & RESTORE"
                    font_size: "13sp"
                    bold: True
                    theme_text_color: "Secondary"
                    size_hint_y: None
                    height: dp(28)
                    padding_x: dp(4)

                MDCard:
                    style: "outlined"
                    radius: [16, 16, 16, 16]
                    adaptive_height: True

                    MDList:
                        spacing: 0

                        MDListItem:
                            on_release: app.export_backup()

                            MDListItemLeadingIcon:
                                icon: "cloud-upload-outline"

                            MDListItemHeadlineText:
                                text: "Export Backup"

                            MDListItemSupportingText:
                                text: "Create a backup and open the share sheet"

                        MDListItem:

                            MDListItemLeadingIcon:
                                icon: "key"

                            MDListItemHeadlineText:
                                text: "Include Rhino Login"

                            MDListItemSupportingText:
                                text: "Include saved login credentials in backups"

                            MDSwitch:
                                widget_style: "ios"
                                active: app.get_backup_setting("backup_login_credentials")
                                on_active: app.set_backup_setting("backup_login_credentials", self.active)

                        MDListItem:

                            MDListItemLeadingIcon:
                                icon: "database-sync-outline"

                            MDListItemHeadlineText:
                                text: "Merge on Import"

                            MDListItemSupportingText:
                                text: "Off replaces existing data; on merges data"

                            MDSwitch:
                                widget_style: "ios"
                                active: app.get_backup_setting("backup_merge_mode")
                                on_active: app.set_backup_setting("backup_merge_mode", self.active)
                        MDListItem:
                            on_release: app.import_backup()

                            MDListItemLeadingIcon:
                                icon: "folder-open-outline"

                            MDListItemHeadlineText:
                                text: "Import Backup"
                # -------------------------------------------------
                # SCHEDULE & DISPLAY
                # -------------------------------------------------

                MDLabel:
                    text: "SCHEDULE & DISPLAY"
                    font_size: "13sp"
                    bold: True
                    theme_text_color: "Secondary"
                    size_hint_y: None
                    height: dp(28)
                    padding_x: dp(4)

                MDCard:
                    style: "outlined"
                    radius: [16, 16, 16, 16]
                    adaptive_height: True

                    MDList:
                        spacing: 0

                        MDListItem:

                            MDListItemLeadingIcon:
                                icon: "refresh"

                            MDListItemHeadlineText:
                                text: "Refresh Schedule on Load"

                            MDSwitch:
                                widget_style: "ios"
                                id: refreshreload
                                active: app.check_att("refreshreload")

                        MDListItem:

                            MDListItemLeadingIcon:
                                icon: "close-circle-outline"

                            MDListItemHeadlineText:
                                text: "Show Canceled Shows"

                            MDSwitch:
                                widget_style: "ios"
                                id: hide_canceled
                                active: app.check_att("hide_canceled")
                                on_active: app.updatetext("hide_canceled")

                        MDListItem:

                            MDListItemLeadingIcon:
                                icon: "hours-24"

                            MDListItemHeadlineText:
                                text: "24 Hour Time"

                            MDSwitch:
                                widget_style: "ios"
                                id: twenty
                                active: app.check_att("twenty")
                                on_active: app.updatetext("twenty")

                        MDListItem:

                            MDListItemLeadingIcon:
                                icon: "ghost"

                            MDListItemHeadlineText:
                                text: "Hide Personal Data"

                            MDSwitch:
                                widget_style: "ios"
                                id: hidden
                        MDListItem:
                            MDListItemHeadlineText:
                                text: "Show Pay Amounts"

                            MDSwitch:
                                widget_style: "ios"
                                id: show_pay_amounts
                                active: app.get_app_setting("show_pay_amounts", "True") == "True"

                                on_active: app.save_app_setting("show_pay_amounts", str(self.active))
                            MDListItemLeadingIcon:
                                icon: "cash"
                                pos_hint: {"center_x": 0.5, "center_y": 0.5}

                        

                        MDListItem:

                            MDListItemLeadingIcon:
                                icon: "file-hidden"

                            MDListItemHeadlineText:
                                text: "Hide Hidden Shows"

                            MDSwitch:
                                widget_style: "ios"
                                id: hide_shows

                        MDListItem:

                            MDListItemLeadingIcon:
                                icon: "hammer-wrench"

                            MDListItemHeadlineText:
                                text: "Rhino Branding"

                            MDSwitch:
                                widget_style: "ios"
                                id: branding

                # -------------------------------------------------
                # NOTIFICATIONS
                # -------------------------------------------------

                MDLabel:
                    text: "NOTIFICATIONS"
                    font_size: "13sp"
                    bold: True
                    theme_text_color: "Secondary"
                    size_hint_y: None
                    height: dp(28)
                    padding_x: dp(4)

                MDCard:
                    style: "outlined"
                    radius: [16, 16, 16, 16]
                    adaptive_height: True

                    MDList:
                        spacing: 0

                        MDListItem:
                            on_release: app.makenots("1")

                            MDListItemLeadingIcon:
                                icon: "bell"

                            MDListItemHeadlineText:
                                text: "Notifications"

                # -------------------------------------------------
                # APP
                # -------------------------------------------------

                MDLabel:
                    text: "APP"
                    font_size: "13sp"
                    bold: True
                    theme_text_color: "Secondary"
                    size_hint_y: None
                    height: dp(28)
                    padding_x: dp(4)

                MDCard:
                    style: "outlined"
                    radius: [16, 16, 16, 16]
                    adaptive_height: True

                    MDList:
                        spacing: 0

                        MDListItem:
                            on_press: app.do_onboarding(0)

                            MDListItemLeadingIcon:
                                icon: "human-greeting"

                            MDListItemHeadlineText:
                                text: "Show Welcome Message"

                # -------------------------------------------------
                # DEVELOPER
                # -------------------------------------------------

                MDLabel:
                    text: "DEVELOPER"
                    font_size: "13sp"
                    bold: True
                    theme_text_color: "Secondary"
                    size_hint_y: None
                    height: dp(28)
                    padding_x: dp(4)

                MDCard:
                    style: "outlined"
                    radius: [16, 16, 16, 16]
                    adaptive_height: True

                    MDList:
                        spacing: 0

                        MDListItem:

                            MDListItemLeadingIcon:
                                icon: "bug"

                            MDListItemHeadlineText:
                                text: "Demo Mode"

                            MDSwitch:
                                widget_style: "ios"
                                id: usecache

                        MDListItem:
                            on_release: app.delete_demo()

                            MDListItemLeadingIcon:
                                icon: "bug"

                            MDListItemHeadlineText:
                                text: "Delete Demo Shows"

    NavigationBar:
        selected: "settings"
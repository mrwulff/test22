
#:import dp kivy.metrics.dp
<LoginCard>:
    orientation: "horizontal"
    size_hint_y: None
    height: dp(130)
    padding: dp(24)
    spacing: dp(12)

    style: "filled"
    radius: [18]

    theme_bg_color: "Custom"
    md_bg_color: app.theme_cls.surfaceContainerColor

    on_release: app.new_login()

    MDBoxLayout:
        orientation: "vertical"
        spacing: dp(4)

        MDLabel:
            text: "Please Log In"
            font_style: "Title"
            role: "large"
            bold: True
            theme_text_color: "Custom"
            text_color: app.theme_cls.onSurfaceColor

        MDLabel:
            text: "Log in to Rhino to load your schedule."
            font_style: "Body"
            role: "medium"
            theme_text_color: "Custom"
            text_color: app.theme_cls.onSurfaceVariantColor

    MDAnchorLayout:
        anchor_x: "center"
        anchor_y: "center"
        size_hint_x: None
        width: dp(110)

        MDCard:
            size_hint: None, None
            size: dp(110), dp(44)
            radius: [22]
            theme_bg_color: "Custom"
            md_bg_color: app.theme_cls.primaryColor
            on_release: app.new_login()

            MDLabel:
                text: "LOG IN"
                halign: "center"
                valign: "center"
                text_size: self.size
                bold: True
                theme_text_color: "Custom"
                text_color: 1, 1, 1, 1
<TodayScreen>:
    name: "today"
    MDScrollView:
        

        MDBoxLayout:
            adaptive_height: True
            spacing: dp(6)
            #padding: dp(36)
            orientation: "vertical"
    

            Widget:
                size_hint_y: None
                #height: self.theme_cls.device_safe_area.top
                height:dp(12)
            
            


            MDGridLayout:
                cols: 2
                spacing: dp(12)
                #padding : dp(12)
                adaptive_height: True

                StatCard:
                    id: update_card
                    icon: "update"
                    value: " "
                    title: ""
                    subtitle: ""
                    on_release: app.update()

                    icon_color: app.theme_cls.secondaryColor
                    circle_color:
                        app.theme_cls.secondaryColor[0], \
                        app.theme_cls.secondaryColor[1], \
                        app.theme_cls.secondaryColor[2], \
                        .12
            
                StatCard:
                    icon: "check-circle"
                    id: confirmed_card
                    value: ""
                    title: ""
                    subtitle: ""
                    on_release: app.check_confirm()

                    icon_color: app.theme_cls.secondaryColor
                    circle_color:
                        app.theme_cls.secondaryColor[0], \
                        app.theme_cls.secondaryColor[1], \
                        app.theme_cls.secondaryColor[2], \
                        .12
            






            MDLabel:
                text: "UP NEXT"
                adaptive_height: True

                font_style: "Label"
                role: "large"

                theme_text_color: "Secondary"

                bold: True

                padding: dp(8), 0
                id:upnext
            LoginCard:
                id: login_card
            ShowCard:
                id: show_card_1
                #show: "Summer Walker"

                class_color: (.20,.55,.95,1)
                show_class: " "

                status_color: (.18,.70,.32,1)

                position_color: (.60,.45,.95,1)
                position: " "

                venue_color: (.55,.35,.80,1)
                venue_code: " "
                #day: "Fri"
                #date: "Jun 19"
                #time: "8:30 PM"

                show: " "
                venue: " "
                address: " "
            ShowCard:
                id: show_card_2
                badge: " "
                badge_color: 0.2,0.45,0.9,1
                stripe_color: 0.2,0.45,0.9,1
                position: " "
                position_color: 0.2,0.45,0.9,1

                day: " "
                date: " "
                time: " "

                show: " "
                venue: " "
                address: " "

            ShowCard:
                id: show_card_3
                badge: " "
                badge_color: 0.2,0.45,0.9,1
                stripe_color: 0.2,0.45,0.9,1
                position: " "
                position_color: 0.2,0.45,0.9,1

                day: " "
                date: " "
                time: " "

                show: " "
                venue: " "
                address: " "


            



            MDGridLayout:
                cols: 2
                spacing: dp(12)
                #padding : dp(12)
                adaptive_height: True

                StatCard:
                    icon: "currency-usd"
                    value: ""
                    title: ""
                    subtitle: ""

                    icon_color: app.theme_cls.secondaryColor
                    circle_color:
                        app.theme_cls.secondaryColor[0], \
                        app.theme_cls.secondaryColor[1], \
                        app.theme_cls.secondaryColor[2], \
                        .12
            
                StatCard:
                    icon: "hours-24"
                    #value: "10 shows"
                    #title: "Have Valid Data"
                    #subtitle: "5 Pending"

                    icon_color: app.theme_cls.secondaryColor
                    circle_color:
                        app.theme_cls.secondaryColor[0], \
                        app.theme_cls.secondaryColor[1], \
                        app.theme_cls.secondaryColor[2], \
                        .12

            


            MDCard:
                radius: [20]
                size_hint_y: None
                height: dp(130)

                MDBoxLayout:
                    orientation: "vertical"
                    padding: dp(16)
                    spacing: dp(12)

                    MDBoxLayout:
                        adaptive_height: True

                        MDLabel:
                            text: "June 2026"
                            bold: True

                        MDIconButton:
                            icon: "chevron-left"

                        MDIconButton:
                            icon: "chevron-right"

                    MDGridLayout:
                        cols: 7
                        adaptive_height: True
                        spacing: dp(4)

                        MDLabel:
                            text: "S"
                            halign: "center"

                        MDLabel:
                            text: "M"
                            halign: "center"

                        MDLabel:
                            text: "T"
                            halign: "center"

                        MDLabel:
                            text: "W"
                            halign: "center"

                        MDLabel:
                            text: "T"
                            halign: "center"

                        MDLabel:
                            text: "F"
                            halign: "center"

                        MDLabel:
                            text: "S"
                            halign: "center"



    NavigationBar:
        selected: "today"
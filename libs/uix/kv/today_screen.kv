


<DrawerClickableItem@MDNavigationDrawerItem>
    focus_color: "#e7e4c0"
    text_color: "#4a4939"
    icon_color: "#4a4939"
    ripple_color: "#c5bdd2"
    selected_color: "#0c6c4d"


<DrawerLabelItem@MDNavigationDrawerItem>
    text_color: "#4a4939"
    icon_color: "#4a4939"
    focus_behavior: False
    selected_color: "#4a4939"
    _no_ripple_effect: True
<NavigationDrawer>
    _list: list
    elevation: 0
    canvas:
        #Color:
        #    rgba: root.theme_cls.bg_light
        Rectangle:
            size: root.size
            pos: root.pos



<SwipeToDeleteItem>:
    size_hint_y: None
    height: content.height

    MDCardSwipeLayerBox:
        padding: "8dp"

        MDButton:
            icon: "trash-can"
            pos_hint: {"center_y": .5}
            on_release: app.remove_item(root)
            MDListItemLeadingIcon:
                icon: "trash-can"  

    MDCardSwipeFrontBox:

        MDListItem:
            id: content

            _no_ripple_effect: True
            MDListItemHeadlineText:
                text: 'wow9'
<Content>
    orientation: "vertical"
    #spacing: "12dp"
    size_hint_y: None
    #height: "60dp"



    MDTextField:
        id: street
        #hint_text: "?!?"



<TodayScreen>
    name: "today"


    MDBoxLayout:
        id: graphs2
        orientation: "vertical"
        #md_bg_color: self.theme_cls.backgroundColor
        MDTopAppBar:
            #title: "Settings"
        #    height: app.mheight
        #    type: "bottom"
            bg_color:self.theme_cls.primaryColor
            MDTopAppBarLeadingButtonContainer:
    
                MDActionTopAppBarButton:
                    icon: "menu"
                    on_release: nav_drawer.set_state("toggle")
                MDActionTopAppBarButton:
                    icon: "shape"
                    #on_release: app.do_payperiod_f("YTD")
                    on_release: app.restart(False)
               
               
                MDActionTopAppBarButton:
                    icon: "check"
                    #on_release: app.do_payperiod_f("YTD")
                    on_release: app.check_confirm()


                MDActionTopAppBarButton:
                    icon: "account-alert-outline"
                    #on_release: app.do_payperiod_f("YTD")
                    on_release: app.make_toast("check_toast")



            #left_action_items:
            #app.update()
            #    [['menu', lambda x: nav_drawer.set_state("open")]]
            #right_action_items: [['reload-alert', lambda screen: app.do_graphOrder(),'order']]
        
        ScrollView:
            id: today_scroll
            MDGridLayout:
                cols: 1
                adaptive_height: True
                padding: dp(4), dp(4)
                spacing: dp(6)
                border_radius: 15
                radius: app.cradius
                
                #text_color:app.theme_cls.primary_color
                MDCard:

                    size_hint_y: None
                    height: dp(120)



                    #size_hint: None,None
                    #height: stats.height
                    #height: self.minimum_height
                    #width:stats.width
                    id:branding
                    #radius: app.cradius
                    #pos_hint: {"center_x": .79, "center_y": .5}
                    #background:"images/walls/logo.png" if app.branding True
                    md_bg_color:1,1,1,1
                    Image:
                        bg_color:1,1,1,1
                        md_bg_color:1,1,1,1
                        #size_hint_y: first.width
                        #width:stats.width
                        id:branding_f


                MDCard:
                    orientation: "vertical"
                    size_hint: .9, None
                    height: stats.height +app.c_top
                    focus_behavior: True
                    ripple_behavior: True
                    #pos_hint: {"center_x": .5, "center_y": .5}
                    on_release: app.check_confirm()
                    #md_bg_color:"elevated"
                    shadow_softness:0 
                    shadow_offset:(0, 1)
                    line_color:(0.2, 0.2, 0.2, 0.8)
                    radius: app.cradius


                    MDListItem:
                        id:stats
                        MDListItemSupportingText:
                            id:s1
                        MDListItemSupportingText:
                            id:s2
                        MDListItemSupportingText:
                            id:s3


                MDCard:
                    orientation: "vertical"
                    size_hint: .9, None
                    height: first.height+app.c_top
                    focus_behavior: True
                    ripple_behavior: True
                    #pos_hint: {"center_x": .5, "center_y": .5}
                    
                    radius: app.cradius
                    #md_bg_color:1,1,1,.5
                    MDListItem:
                        on_release: app.pop_new(0)
                        id:first
                        #text: "First Show"
                        #secondary_text: "Secondary text here"
                        #theme_text_color: "Custom"
                        #text_color:"Blue"
                        MDListItemLeadingIcon:
                            id:1l
                            #icon: app.find_type(0,"type") 
                            pos_hint:{"center_x": 0.5, "center_y": 0.5}
                            icon_color:app.theme_cls.primaryColor
                        MDListItemTrailingIcon:
                            
                            id:1r
                            pos_hint:{"center_x": 0.5, "center_y": 0.5}
                            icon_color:app.theme_cls.primaryColor
                        MDListItemSupportingText:
                            text:'first1'
                            id:first1
                        MDListItemSupportingText:
                            text:'first2'
                            id:first2
                        MDListItemSupportingText:
                            text:'first3'
                            id:first3

                        
                MDCard:
                    orientation: "vertical"
                    size_hint: .9, None
                    height: second.height +app.c_top

                    focus_behavior: True
                    ripple_behavior: True
                    #pos_hint: {"center_x": .5, "center_y": .5}
                    
                    radius: app.cradius
                    MDListItem:
                        on_release: app.pop_new(1)
                        id:second
                        #text: "First Show"
                        #secondary_text: "Secondary text here"
                        text_color:"Error"
                        MDListItemLeadingIcon:
                            pos_hint:{"center_x": 0.5, "center_y": 0.5}
                            id:2l
                            #icon: app.find_type(1,"type") 
                            icon_color:app.theme_cls.primaryColor
                        MDListItemTrailingIcon:
                            pos_hint:{"center_x": 0.5, "center_y": 0.5}
                            #icon: app.find_type(1,"pos")  
                            id:2r 
                            icon_color:app.theme_cls.primaryColor
                        MDListItemSupportingText:
                            text:'wow'
                            id:second1
                        MDListItemSupportingText:
                            text:'wow55'
                            id:second2
                        MDListItemSupportingText:
                            text:'wow44'
                            id:second3
                        MDListItemLeadingIcon:
                            #id:1l
                            #icon: app.find_type(0,"type") 

                MDCard:
                    orientation: "vertical"
                    size_hint: .9, None
                    height: third.height +app.c_top

                    focus_behavior: True
                    ripple_behavior: True
                    #pos_hint: {"center_x": .5, "center_y": .5}
                    
                    radius: app.cradius
                    MDListItem:
                        on_release: app.pop_new(2)
                        id:third
                        #text: "First Show"
                        #secondary_text: "Secondary text here"
                        MDListItemLeadingIcon:
                            id:3l
                            pos_hint:{"center_x": 0.5, "center_y": 0.5}
                            #icon: app.find_type(2,"type") 
                            icon_color:app.theme_cls.primaryColor
                        MDListItemTrailingIcon:
                            #icon: app.find_type(2,"pos")  
                            id:3r 
                            pos_hint:{"center_x": 0.5, "center_y": 0.5}
                            icon_color:app.theme_cls.primaryColor
                        MDListItemSupportingText:
                            text:'wow22'
                            id:third1
                        MDListItemSupportingText:
                            text:'wow33'
                            id:third2
                        MDListItemSupportingText:
                            text:'wow11'
                            id:third3
                        MDListItemLeadingIcon:
                            #id:1l
                            #icon: app.find_type(0,"type") 



                MDDivider:

                #    height:dp(50)
                #    color:0,0,0,0
                MDBoxLayout:
                    
                    #orientation: "vertical"
                    #size_hint: .8, 1
                    size_hint: None, None
                    height: dp(40)
                    #width: butt.width+butt2.width+butt3.width+butt3.width/2
                    #width:lolz.width
                    cols: 3
                    adaptive_height: True
                    padding: dp(10), dp(10)
                    focus_behavior: True
                    ripple_behavior: False
                    id:lolz
                    #pos_hint: {"center_x": .8, "center_y": .5}
                    radius: app.cradius
                    #padding:10
                    spacing:10
                    MDButton:
                        size_hint: 6.9, None
                        style: "tonal"
                        #height: second.height +app.c_top
                        id:butt
                        #height: self.minimum_height
                        #width:butt.width*dp(5)
                        text: "Show All"
                        on_release: 
                            app.newstart("",False)
                            #app.partial(app.launch_thread,self.func_that_take_time)
                        #pos_hint: {"center_x": .25, "center_y": .5}
                        #pos:{"center_x": .25, "center_y": .5}
                        #set_radius: app.cradius
                        radius: app.cradius
                        MDButtonText:
                            text: "Show All"
                    MDButton:
                        id:butt2
                        style: "tonal"
                        text: "Past"
                        #secondary_text: "Secondary text here"
                        #on_release: app.newstart("",True)
                        on_release: app.show_archive()
                        #pos_hint: {"center_x": .45, "center_y": .5}
                        radius: app.cradius
                        #height: self.minimum_height
                        MDButtonText:
                            text: "Past"
                    MDButton:
                        style: "tonal"
                        id:butt3
                        text: "Update"
                        radius: app.cradius
                        #secondary_text: "Secondary text here"
                        on_release: app.update()
                        #pos_hint: {"center_x": .79, "center_y": .5}
                        MDButtonText:
                            text: "Update"
                    MDIconButton:
                        id: refresh_button
                        icon: "refresh"
                    



                MDDivider:
                    
                MDCardSwipeFrontBox:
                    #orientation: "vertical"
                    size_hint: .9, None
                    height: second.height 
                    focus_behavior: True
                    ripple_behavior: True
                    #pos_hint: {"center_x": .5, "center_y": .6}
                    radius: app.cradius
                    #on_swipe_complete:app.lol()
                    
                    MDListItem:
                        id:pay
                        size_hint: .9, None
                        height: second.height 
                        #font_name:'NotoColorEmoji.ttf'
                        font_name:"seguiemj"
                        text: "Next Paycheck🌶️"
                        secondary_text: "Secondary text here"
                        #tertiary_text: "Shows: 50"
                        #height: pay.height+dp(1000)
                        #on_press:(app.do_payperiod_f('YTD'))
                        MDIconButton:
                            icon: "menu-left"  
                            on_release: app.do_pp_sum(-1,'pp')
                        MDIconButton:
                            
                            icon: "menu-right"  
                            on_release: app.do_pp_sum(1,'pp')
                        MDListItemHeadlineText:
                        
                            text:'WHAT'
                            id:pay1
                        MDListItemSupportingText:
                            id:pay2
                            secondary_text:'who'
                        MDListItemSupportingText:
                            id:pay3
                            secondary_text:'who'
                ####start of cal########
                MDBoxLayout:
                    orientation: "vertical"
                    id: cal_box
                    height: self.minimum_height
                    #pos_hint:None,None
                    md_bg_color:1,0,0,0
                    #height:cal_box.height
                    width: app.cal_width
                    size_hint_y: None

                    


                    MDCard:
                        orientation: "horizontal"
                        size_hint_y: None
                        height: dp(42)

                        MDListItem:
                            id: cal_month
                            height: dp(42)
                            orientation: "horizontal"


                            MDIconButton:
                                icon: "share"
                                pos_hint: {"center_y": .5}
                                x: self.parent.width - dp(140)
                                on_press: app.share_calendar()


                            MDIconButton:
                                icon: "menu-left"
                                pos_hint: {"center_y": .5}
                                x: self.parent.width - dp(90)
                                on_press: app.do_pp_sum(-1, 'cal')

                            MDListItemHeadlineText:
                                id: cal_month_text

                            MDIconButton:
                                icon: "menu-right"
                                pos_hint: {"center_y": .5}
                                x: self.parent.width - dp(40)
                                on_press: app.do_pp_sum(1, 'cal')


                    MDCard:
                        orientation: "horizontal"
                        size_hint: 1, None
                        font_size:3
                        #size:.5,.5
                        height: dp(42)
                        width:dp(5)
                        focus_behavior: True
                        ripple_behavior: True
                        #pos_hint: {"center_x": .5, "center_y": .6}
                        radius: app.cradius
                        id:calm
                        text:'month'
                        #md_bg_color:app.cal_bg



                    MDGridLayout:
                        id: calgrid
                        cols: 7
                        spacing: dp(2)
                        size_hint_y: None
                        height: self.minimum_height
                        row_default_height: dp(48)
                        row_force_default: True

                #Label:
    MDNavigationDrawer:
        id: nav_drawer
        #type: "modal"
        #radius: (0, 16, 16, 0)
        

        ContentNavigationDrawer:
            MDNavigationDrawerMenu:
                id:drawer
                

                MDNavigationDrawerHeader:
                    title: " Menu"
                    #title_color: "#4a4939"
                    text: "  v24.1.15.916"
                    spacing: "6dp"

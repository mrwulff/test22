
#:import dp kivy.metrics.dp

<TodayScreen>:
    name: "today"
    MDScrollView:
        

        MDBoxLayout:
            adaptive_height: True
            spacing: dp(6)
            #padding: dp(36)
            orientation: "vertical"

            Widget:
                size_hint_y: None
                #height: self.theme_cls.device_safe_area.top
                height:dp(36)
            
            


            MDGridLayout:
                cols: 2
                spacing: dp(12)
                #padding : dp(12)
                adaptive_height: True

                StatCard:
                    icon: "clock-outline"
                    value: "148"
                    title: " YTD"
                    subtitle: "today"

                    icon_color: app.theme_cls.secondaryColor
                    circle_color:
                        app.theme_cls.secondaryColor[0], \
                        app.theme_cls.secondaryColor[1], \
                        app.theme_cls.secondaryColor[2], \
                        .12
            
                StatCard:
                    icon: "clock-outline"
                    value: "1480"
                    title: "HOURS "
                    subtitle: "As of "

                    icon_color: app.theme_cls.secondaryColor
                    circle_color:
                        app.theme_cls.secondaryColor[0], \
                        app.theme_cls.secondaryColor[1], \
                        app.theme_cls.secondaryColor[2], \
                        .12
            






            MDLabel:
                text: "Up Next"
                bold: True
                size_hint_y: None
                font_style: "Title"
                role: "medium"
                height: self.texture_size[1]
                text_color: app.theme_cls.secondaryColor
                #text_color: (1,1,1)
            ShowCard:
                badge: "SHOW"
                badge_color: 0.2,0.45,0.9,1
                stripe_color: 0.2,0.45,0.9,1
                position: "A1"
                position_color: 0.2,0.45,0.9,1

                day: "Fri"
                date: "Jun 19"
                time: "8:30 PM"

                show: "Summer Walker"
                venue: "T-Mobile Arena"
                address: "3780 S Las Vegas Blvd"
            MDCard:
                radius: [5]
                size_hint_y: None
                height: dp(130)
                MDLabel:
                    text: "THU 18 • ACMA Awards"
                    halign: "center"
            MDCard:
                radius: [10]
                size_hint_y: None
                height: dp(130)
                MDLabel:
                    text: "THU 18 • ACMA Awards"
                    halign: "center"

            MDGridLayout:
                cols: 4
                adaptive_height: True
                spacing: dp(12)

                MDCard:
                    radius: [20]
                    size_hint_y: None
                    height: dp(84)
                    MDLabel:
                        text: "Calendar"
                        halign: "center"

                MDCard:
                    radius: [20]
                    size_hint_y: None
                    height: dp(84)
                    MDLabel:
                        text: "Confirm"
                        halign: "center"

                MDCard:
                    radius: [20]
                    size_hint_y: None
                    height: dp(84)
                    MDLabel:
                        text: "Pay"
                        halign: "center"

                MDCard:
                    radius: [20]
                    size_hint_y: None
                    height: dp(84)
                    MDLabel:
                        text: "Archive"
                        halign: "center"

            MDCard:
                radius: [20]
                size_hint_y: None
                height: dp(260)

                MDBoxLayout:
                    orientation: "vertical"
                    padding: dp(16)
                    spacing: dp(12)

                    MDBoxLayout:
                        adaptive_height: True

                        MDLabel:
                            text: "June 2026"
                            bold: True

                        MDIconButton:
                            icon: "chevron-left"

                        MDIconButton:
                            icon: "chevron-right"

                    MDGridLayout:
                        cols: 7
                        adaptive_height: True
                        spacing: dp(4)

                        MDLabel:
                            text: "S"
                            halign: "center"

                        MDLabel:
                            text: "M"
                            halign: "center"

                        MDLabel:
                            text: "T"
                            halign: "center"

                        MDLabel:
                            text: "W"
                            halign: "center"

                        MDLabel:
                            text: "T"
                            halign: "center"

                        MDLabel:
                            text: "F"
                            halign: "center"

                        MDLabel:
                            text: "S"
                            halign: "center"

            MDCard:
                radius: [20]
                size_hint_y: None
                height: dp(100)
                MDLabel:
                    text: "Next Payday\nJune 22"
                    halign: "center"

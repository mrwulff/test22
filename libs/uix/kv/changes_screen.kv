#:import dp kivy.metrics.dp


<PendingConfirmCard>:
    orientation: "horizontal"
    size_hint_y: None
    height: dp(90)
    padding: dp(16), dp(10)
    spacing: dp(12)

    style: "filled"
    radius: [18, 18, 18, 18]
    theme_bg_color: "Custom"
    md_bg_color: app.theme_cls.surfaceContainerColor

    MDBoxLayout:
        orientation: "vertical"
        spacing: dp(2)

        MDLabel:
            text: root.show_name
            font_style: "Title"
            role: "medium"
            bold: True
            theme_text_color: "Custom"
            text_color: app.theme_cls.onSurfaceColor
            shorten: True
            shorten_from: "right"

        MDLabel:
            text:
                root.show_date + " • " + root.show_time \
                if root.show_date and root.show_time \
                else root.show_date \
                if root.show_date \
                else root.show_time

            font_style: "Body"
            role: "large"
            theme_text_color: "Custom"
            text_color: app.theme_cls.onSurfaceVariantColor
            shorten: True
            shorten_from: "right"

    MDButton:
        style: "filled"
        size_hint: None, None
        width: dp(105)
        height: dp(44)
        pos_hint: {"center_y": .5}

        on_release:
            app.root.get_screen("changes").confirm_one(root.confirm_id)

        MDButtonText:
            text: "CONFIRM"


<ChangeCard>:
    orientation: "vertical"
    size_hint_y: None
    height: dp(100) + dp(24) * root.change_count

    padding: dp(16), dp(10)
    spacing: dp(4)

    style: "filled"
    radius: [18, 18, 18, 18]
    theme_bg_color: "Custom"
    md_bg_color: app.theme_cls.surfaceContainerColor

    MDBoxLayout:
        orientation: "horizontal"
        size_hint_y: None
        height: dp(32)
        spacing: dp(8)

        MDLabel:
            text: root.show_name
            font_style: "Title"
            role: "medium"
            bold: True
            theme_text_color: "Custom"
            text_color: app.theme_cls.onSurfaceColor
            shorten: True
            shorten_from: "right"

        MDBoxLayout:
            size_hint: None, None
            size: dp(112), dp(32)
            radius: [10, 10, 10, 10]
            md_bg_color: root.badge_color

            MDLabel:
                text: root.badge
                halign: "center"
                valign: "middle"
                bold: True
                font_style: "Label"
                role: "medium"
                theme_text_color: "Custom"
                text_color: (1, 1, 1, 1)

    MDLabel:
        text:
            root.show_date + " • " + root.show_time \
            if root.show_date and root.show_time \
            else root.show_date \
            if root.show_date \
            else root.show_time

        size_hint_y: None
        height: dp(24)
        font_style: "Body"
        role: "large"
        theme_text_color: "Custom"
        text_color: app.theme_cls.onSurfaceColor
        shorten: True
        shorten_from: "right"

    MDLabel:
        text: root.change_summary
        size_hint_y: None
        height: dp(22) * root.change_count
        text_size: self.width, self.height
        halign: "left"
        valign: "middle"
        font_style: "Body"
        role: "medium"
        theme_text_color: "Custom"
        text_color: app.theme_cls.onSurfaceColor

    MDLabel:
        text: root.timestamp
        size_hint_y: None
        height: dp(18)
        font_style: "Body"
        role: "small"
        theme_text_color: "Custom"
        text_color: app.theme_cls.onSurfaceVariantColor


<ChangesScreen>:
    BoxLayout:
        orientation: "vertical"

        # One scroll container for the entire page.
        ScrollView:
            do_scroll_x: False
            do_scroll_y: True
            bar_width: dp(4)

            MDBoxLayout:
                orientation: "vertical"
                adaptive_height: True
                padding: dp(12)
                spacing: dp(10)

                # ------------------------------------------
                # PENDING CONFIRMATIONS
                # This section collapses when empty.
                # ------------------------------------------

                MDBoxLayout:
                    id: pending_section
                    orientation: "vertical"
                    adaptive_height: True
                    spacing: dp(8)

                    MDBoxLayout:
                        id: pending_header
                        orientation: "horizontal"
                        size_hint_y: None
                        height: dp(48)
                        spacing: dp(8)

                        MDLabel:
                            text: "PENDING CONFIRMATIONS"
                            font_style: "Headline"
                            role: "small"
                            bold: True
                            theme_text_color: "Custom"
                            text_color: app.theme_cls.onSurfaceColor

                        MDButton:
                            style: "filled"
                            size_hint: None, None
                            width: dp(160)
                            height: dp(48)
                            pos_hint: {"center_y": .5}

                            on_release:
                                app.root.get_screen("changes").confirm_all()

                            MDButtonText:
                                text: "CONFIRM ALL"

                    MDBoxLayout:
                        id: pending_list
                        orientation: "vertical"
                        adaptive_height: True
                        spacing: dp(8)

                # ------------------------------------------
                # SCHEDULE CHANGES
                # ------------------------------------------

                MDLabel:
                    text: "SCHEDULE CHANGES"
                    size_hint_y: None
                    height: dp(42)
                    font_style: "Headline"
                    role: "small"
                    bold: True
                    theme_text_color: "Custom"
                    text_color: app.theme_cls.onSurfaceColor

                MDBoxLayout:
                    id: change_list
                    orientation: "vertical"
                    adaptive_height: True
                    spacing: dp(10)

        NavigationBar:
            selected: "changes"
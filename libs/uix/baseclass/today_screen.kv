#:import dp kivy.metrics.dp

<HeroCard@MDCard>:
    radius: [24]
    padding: dp(20)
    spacing: dp(12)
    orientation: "vertical"
    adaptive_height: True

<StatCard@MDCard>:
    radius: [20]
    padding: dp(16)
    adaptive_height: True

<QuickTile@MDCard>:
    radius: [20]
    padding: dp(12)
    adaptive_height: True

<ShowCard@MDCard>:
    radius: [20]
    padding: dp(16)
    spacing: dp(8)
    orientation: "vertical"
    adaptive_height: True

<CalendarCard@MDCard>:
    radius: [20]
    padding: dp(16)
    spacing: dp(12)
    orientation: "vertical"
    adaptive_height: True

<TodayScreen>:
    name: "today"

    MDBoxLayout:
        orientation: "vertical"

        MDTopAppBar:
            id: topbar
            headline_text: "Today"

        MDScrollView:

            MDBoxLayout:
                id: content
                orientation: "vertical"
                adaptive_height: True
                spacing: dp(16)
                padding: dp(16)

                HeroCard:
                    id: hero_card

                MDGridLayout:
                    id: stats_grid
                    cols: 2
                    adaptive_height: True
                    spacing: dp(12)

                    StatCard:
                        id: stat_1

                    StatCard:
                        id: stat_2

                    StatCard:
                        id: stat_3

                    StatCard:
                        id: stat_4

                MDLabel:
                    id: next_header
                    text: "Up Next"
                    bold: True
                    adaptive_height: True

                ShowCard:
                    id: next_show

                MDGridLayout:
                    id: quick_actions
                    cols: 4
                    adaptive_height: True
                    spacing: dp(12)

                    QuickTile:
                        id: tile_calendar

                    QuickTile:
                        id: tile_confirm

                    QuickTile:
                        id: tile_pay

                    QuickTile:
                        id: tile_archive

                CalendarCard:

                    MDBoxLayout:
                        id: calendar_header
                        adaptive_height: True

                    MDGridLayout:
                        id: weekday_header
                        cols: 7
                        adaptive_height: True
                        spacing: dp(2)

                    MDGridLayout:
                        id: calendar_grid
                        cols: 7
                        adaptive_height: True
                        spacing: dp(2)

                MDLabel:
                    text: "Recent Activity"
                    bold: True
                    adaptive_height: True

                MDBoxLayout:
                    id: recent_activity
                    orientation: "vertical"
                    adaptive_height: True

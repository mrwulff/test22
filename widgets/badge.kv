<Badge>:
    style: "filled"

    size_hint: None, None
    width: dp(84)
    height: dp(22)

    radius: [11]

    md_bg_color: root.bg_color

    MDLabel:
        text: root.text

        halign: "center"
        valign: "middle"

        theme_text_color: "Custom"
        text_color: root.fg_color

        font_style: "Label"
        role: "small"